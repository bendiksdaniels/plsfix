# Copy to .env next to docker-compose.yml (the .env itself is git-ignored).
# The public HTTPS address of this deployment, trailing slash included: the
# manifest at <PLSFIX_PUBLIC_URL>manifest.xml points every URL at it.
PLSFIX_PUBLIC_URL=https://models.example.com/
# The host name Caddy serves under the https profile: a DNS name of this machine.
PLSFIX_DOMAIN=models.example.com
