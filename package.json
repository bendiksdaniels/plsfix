{
  "name": "plsfix",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "A focused Excel productivity add-in for financial modelling teams.",
  "config": {
    "app_to_debug": "excel",
    "app_type_to_debug": "desktop",
    "dev_server_command": "npm run dev-server",
    "dev_server_port": 3000
  },
  "scripts": {
    "dev": "vite",
    "dev-server": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "start": "office-addin-debugging start manifest.xml desktop",
    "stop": "office-addin-debugging stop manifest.xml",
    "poststop": "sh scripts/wef-restore-prod.sh",
    "validate": "office-addin-manifest validate manifest.xml && office-addin-manifest validate manifest.prod.xml",
    "manifest:build": "tsx scripts/build-manifests.ts",
    "manifest:check": "tsx scripts/build-manifests.ts --check"
  },
  "dependencies": {
    "office-js": "0.1.0"
  },
  "devDependencies": {
    "@types/office-js": "1.0.606",
    "jsdom": "26.1.0",
    "office-addin-debugging": "6.1.2",
    "office-addin-dev-certs": "2.0.10",
    "office-addin-manifest": "2.1.6",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
