{
  "name": "plsfix",
  "version": "2.8.19",
  "private": true,
  "type": "module",
  "description": "A focused Excel productivity add-in for financial modelling teams.",
  "config": {
    "app_to_debug": "excel",
    "app_type_to_debug": "desktop",
    "dev_server_command": "npm run dev-server",
    "dev_server_port": 3000
  },
  "scripts": {
    "functions:js": "vite build --config vite.functions.config.ts",
    "predev": "npm run functions:js",
    "dev": "vite",
    "predev-server": "npm run functions:js",
    "dev-server": "vite",
    "build": "tsc --noEmit && tsx scripts/build-functions-metadata.ts && tsx scripts/build-shortcuts-page.ts && npm run functions:js && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:server": "cargo test --manifest-path server/Cargo.toml",
    "prestart": "npm run functions:js",
    "start": "office-addin-debugging start manifest.xml desktop",
    "stop": "office-addin-debugging stop manifest.xml",
    "poststop": "sh scripts/wef-restore-prod.sh",
    "prestart:ppt": "npm run functions:js",
    "start:ppt": "office-addin-debugging start manifest.xml desktop --app powerpoint",
    "stop:ppt": "office-addin-debugging stop manifest.xml --app powerpoint && sh scripts/wef-restore-prod.sh",
    "validate": "office-addin-manifest validate manifest.xml && office-addin-manifest validate manifest.prod.xml",
    "manifest:build": "tsx scripts/build-manifests.ts",
    "manifest:check": "tsx scripts/build-manifests.ts --check",
    "ribbon-icons:build": "tsx scripts/build-ribbon-icons.ts",
    "functions:build": "tsx scripts/build-functions-metadata.ts",
    "functions:check": "tsx scripts/build-functions-metadata.ts --check",
    "shortcuts:build": "tsx scripts/build-shortcuts-page.ts",
    "shortcuts:check": "tsx scripts/build-shortcuts-page.ts --check",
    "version:check": "tsx scripts/check-version.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run test:server && npm run test:demo && npm run manifest:check && npm run validate && npm run functions:check && npm run shortcuts:check && npm run version:check",
    "ux:check": "node scripts/ux-check.mjs",
    "ux:sweep": "node scripts/ux/click-sweep.mjs",
    "rig": "node scripts/rig/drive.mjs",
    "rig:manifests": "node scripts/rig/serve-manifest.mjs",
    "demo": "sh scripts/demo-open.sh",
    "demo:build": "cargo run --quiet --manifest-path demo/Cargo.toml",
    "demo:deck": "demo/deck/.venv/bin/python demo/deck/build_deck.py",
    "test:demo": "cargo test --manifest-path demo/Cargo.toml",
    "manual": "cargo run --quiet --manifest-path manual/Cargo.toml"
  },
  "devDependencies": {
    "@types/custom-functions-runtime": "1.6.13",
    "@types/office-js": "1.0.606",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "9.39.5",
    "jsdom": "26.1.0",
    "office-addin-debugging": "6.1.2",
    "office-addin-dev-certs": "2.0.10",
    "office-addin-manifest": "2.1.6",
    "prettier": "3.9.6",
    "tsx": "4.23.12",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.68.0",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bendiksdaniels/plsfix.git"
  },
  "homepage": "https://dbautomatizacijas.com/modelis/",
  "bugs": {
    "url": "https://github.com/bendiksdaniels/plsfix/issues"
  }
}
