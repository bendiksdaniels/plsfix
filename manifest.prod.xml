<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- Production manifest: same GUID as manifest.xml (same add-in identity), only URLs differ.
     Served LIVE from https://dbautomatizacijas.com/modelis/ (suite key modelis, Rust host :8804).
     The path carries a Cloudflare Access bypass - Office webviews cannot pass Access
     (docs/research/launch-path.md), so only built pane assets may live there. -->
